# 使用方式：cp .env.example .env，再按需修改。
# 注意：.env 已被 .gitignore 忽略，请勿把真实密钥提交到仓库。

# ---- 应用 ----
APP_NAME="rag-knowledge-base"
LOG_LEVEL="INFO"

# ---- PostgreSQL（默认值与 docker-compose.yml 保持一致，本地可直接运行）----
POSTGRES_USER="rag"
POSTGRES_PASSWORD="rag"
POSTGRES_DB="rag_kb"
POSTGRES_PORT="5432"

# ---- 数据库连接串 ----
# 留空时由上面的 POSTGRES_* 自动拼接；显式填写时支持 ${VAR} 插值。
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}"

# ---- 腾讯云 COS（不使用时留空，应用仍可启动，健康检查会返回配置缺失）----
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_REGION="ap-guangzhou"
COS_BUCKET=""

# ---- CORS 允许来源，多个用英文逗号分隔 ----
CORS_ORIGINS="http://localhost:5173"

# === Embedding ===
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL="https://ws-j9yvjavs76o44pca.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
EMBEDDING_MODEL="qwen3.7-text-embedding"
EMBEDDING_DIM=1024

# === 文档上传与切分 ===
UPLOAD_MAX_SIZE_MB=50
# 包含 Docling 模型初始化、下载及转换的总超时；超时终止解析进程
DOCUMENT_PARSE_TIMEOUT_SECONDS=180
CHUNK_SIZE=600
CHUNK_OVERLAP=60

# === HuggingFace 镜像 ===
HF_ENDPOINT="https://hf-mirror.com"

# === Chat 模型(DashScope OpenAI 兼容协议) ===
# 默认与 embedding 同 base_url
CHAT_API_KEY=""
CHAT_BASE_URL="https://ws-j9yvjavs76o44pca.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
CHAT_MODEL="qwen3.7-flash"

# === 检索与问答 ===
# === 检索 Top-K: 交给LLM的候选 chunk 数量
RETRIEVAL_TOP=5
# 拒答阈值: cosine similarity(= 1 - cosine_distance)的下限
# Top-K 中最高分仍低于此值，直接拒答，不调LLM
RETRIEVAL_MIN_SCORE=0.6
# 多轮窗口: load_context 节点取最近多少轮塞进 prompt
CHAT_HISTORY_WINDOW=5

# ==== query 优化 ====
# 关掉后 route_query 节点强制走 original，方便对比有/无路由的效果
QUERY_ROUTING_ENABLED=True
# Multi-Query 策略生成的子查询数量，过大会增加 embedding 成本
MULTI_QUERY_COUNT=3

# ===== 混合检索 =====
# 每路（向量 / 关键词）召回数量；设计文档建议候选 20-50
# 取 20 兼顾召回率与 RRF 融合开销
RETRIEVAL_RECALL_TOP_K=20
# RRF 平滑常数，业界一般用 60；越小越偏向高排名条目
RRF_K=60

# ==== Agentic RAG ====
# 关掉后图退化为单轮检索，作为单轮 vs agent 循环的对比开关
AGENT_LOOP_ENABLED=True
# 最大检索轮次（含首轮）。LLM 决策最多触发 max_rounds - 1 次再检索，避免循环调用
AGENT_MAX_ROUNDS=3

# ===== Reranker =====
# 关掉后 rerank 节点直接透传，作为有/无精排的对比开关
RERANK_ENABLED=True
RERANK_MODEL=qwen3.7-text-rerank
# DashScope rerank 端点，不是标准 OpenAI API
RERANK_BASE_URL="https://ws-j9yvjavs76o44pca.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks"
# 留空则自动复用 CHAT_API_KEY
RERANK_API_KEY=
# rerank Top1 相关度低于此阈值时拒答（qwen3-rerank score ∈ [0, 1]）
RERANK_MIN_SCORE=0.3
RERANK_TIMEOUT=8.0

# ===== 答案校验 =====
# 关掉后跳过 verify_answer 调用，方便对比有/无引用支撑校验的效果
VERIFY_ANSWER_ENABLED=True
