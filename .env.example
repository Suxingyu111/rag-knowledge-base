# 使用方式：cp .env.example .env，再按需修改。
# 注意：.env 已被 .gitignore 忽略，请勿把真实密钥提交到仓库。

# ---- 应用 ----
APP_NAME="rag-knowledge-base"
LOG_LEVEL="INFO"

# ---- PostgreSQL（默认值与 docker-compose.yml 保持一致，本地可直接运行）----
POSTGRES_USER="rag"
POSTGRES_PASSWORD="rag"
POSTGRES_DB="rag_kb"
POSTGRES_PORT="5432"

# ---- 数据库连接串 ----
# 留空时由上面的 POSTGRES_* 自动拼接；显式填写时支持 ${VAR} 插值。
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}"

# ---- 腾讯云 COS（不使用时留空，应用仍可启动，健康检查会返回配置缺失）----
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_REGION="ap-guangzhou"
COS_BUCKET=""

# ---- CORS 允许来源，多个用英文逗号分隔 ----
CORS_ORIGINS="http://localhost:5173"

# === Embedding ===
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL="https://ws-j9yvjavs76o44pca.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
EMBEDDING_MODEL="qwen3.7-text-embedding"
EMBEDDING_DIM=1024

# === 文档上传与切分 ===
UPLOAD_MAX_SIZE_MB=50
# 包含 Docling 模型初始化、下载及转换的总超时；超时终止解析进程
DOCUMENT_PARSE_TIMEOUT_SECONDS=180
CHUNK_SIZE=600
CHUNK_OVERLAP=60

# === HuggingFace 镜像 ===
HF_ENDPOINT="https://hf-mirror.com"
